{
  "name": "secure-file-vault",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "electron/main.cjs",
  "description": "安全文件存储系统 — 课程项目 3",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "npx -y node@20 scripts/ui-smoke.mjs",
    "test:ui:restore": "npx -y node@20 scripts/restore-smoke.mjs",
    "test:ui:key-export": "npx -y node@20 scripts/key-export-smoke.mjs",
    "test:ui:dragdrop": "npx -y node@20 scripts/dragdrop-smoke.mjs",
    "benchmark:report": "npx -y node@20 scripts/benchmark-report.mjs",
    "electron:run": "npm run build && electron .",
    "electron:dir": "npm run build && electron-builder --win dir",
    "electron:dist": "npm run build && electron-builder --win portable",
    "test:electron": "npx -y node@20 scripts/electron-smoke.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json"
  },
  "dependencies": {
    "@ant-design/icons": "^5.5.1",
    "@peculiar/x509": "^1.12.3",
    "antd": "^5.22.0",
    "hash-wasm": "^4.12.0",
    "idb": "^8.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "zod": "^3.24.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^20.17.9",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "fake-indexeddb": "^6.0.0",
    "jsdom": "^25.0.1",
    "playwright-core": "^1.64.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
